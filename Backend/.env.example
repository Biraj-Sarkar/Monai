# Backend environment variables example
# Copy this to .env and fill in real values (do NOT commit secrets)

# Node env
NODE_ENV=development

# Port the server listens on
PORT=5000

# MongoDB connection string (MongoDB Atlas or local)
MONGO_URI=mongodb://localhost:27017/expense-tracker

# JWT secret for signing access tokens (use a long random string in production)
JWT_SECRET=changeme_change_this_to_a_long_secret_32_chars_min

# JWT refresh secret (used to sign refresh tokens stored in httpOnly cookies)
JWT_REFRESH_SECRET=another_long_refresh_secret_32_chars_min

# Frontend origin for CORS
CLIENT_URL=http://localhost:5173

# Backend origin used in email links (unsubscribe, callbacks)
BACKEND_URL=http://localhost:5000

# Google OAuth client ID used to verify Google ID tokens
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Email and password for contact us
EMAIL=your-email@gmail.com
PASSWORD=your-app-password  # Use an App Password, not your real password

# ---------------------------
# Vestauth (agent) settings
# ---------------------------
# These values are created when you register this service as a vestauth "tool".
# Run with `VESTAUTH_INIT=true node server.js` once during provisioning to write
# `TOOL_UID`, `TOOL_PUBLIC_JWK`, and `TOOL_PRIVATE_JWK` into your `.env` file.
# Keep `TOOL_PRIVATE_JWK` and other secrets out of source control.

# Set to true only when you want the app to attempt registration and persist
# TOOL_* values into the local `.env` file. Do NOT enable in normal runtime.
VESTAUTH_INIT=false

# Optional: the persisted tool UID (filled after init)
TOOL_UID=

# Public JWK for your tool (JSON string)
TOOL_PUBLIC_JWK=

# Private JWK for your tool (JSON string) — sensitive, do NOT commit
TOOL_PRIVATE_JWK=

# Optional hostname to register with (defaults to https://api.vestauth.com)
TOOL_HOSTNAME=

